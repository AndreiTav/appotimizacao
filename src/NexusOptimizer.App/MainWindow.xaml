<ui:FluentWindow x:Class="NexusOptimizer.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:NexusOptimizer.App.Controls"
 Title="NEXUS OPTIMIZER" Width="1400" Height="920" MinWidth="1120" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="26,30,18,30">
     <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="N" Foreground="#0B1822" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="N E X U S" FontSize="20" FontWeight="Bold"/><TextBlock Text="O P T I M I Z E R" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel>
     <TextBlock Text="CONTROLE. EQUILÍBRIO. DESEMPENHO." FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Margin="16" Padding="14" CornerRadius="10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="LOCAL POR PRINCÍPIO" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Sem telemetria. Você decide cada alteração." Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="MVP 0.1 · Windows 11 x64" Style="{StaticResource Muted}" FontSize="10" Margin="0,14,0,0"/></StackPanel></Border>
    <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="30,12">
    <DockPanel><Button DockPanel.Dock="Right" Content="Configurações  ↗" Command="{Binding GoSettingsCommand}"/><StackPanel DockPanel.Dock="Right" Margin="20,8,22,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="SESSÃO LOCAL" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></StackPanel><TextBlock Text="{Binding MachineName}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="SEU SISTEMA, SOB SEU CONTROLE" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding OptimizationSummary}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel>
   </Border>
   <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedPage}" BorderThickness="0" Background="Transparent" Padding="0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"><ContentPresenter.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger></ContentPresenter.Triggers></ContentPresenter></ControlTemplate></TabControl.Template>
    <!-- DASHBOARD -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,28,16,20">
     <TextBlock Text="Visão geral" Style="{StaticResource Title}"/><TextBlock Text="Conheça seu hardware. Encontre oportunidades sem alterar o sistema." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="O próximo passo começa com uma análise." FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Diagnóstico real, recomendações explicadas e controle sobre cada ajuste." Style="{StaticResource Muted}" Margin="0,10,15,0"/></StackPanel><Button Grid.Column="1" Content="ANALISAR MEU PC  ↗" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center"/></Grid></Border>
     <UniformGrid Columns="2">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROCESSADOR" Style="{StaticResource Muted}"/><DockPanel Margin="0,12,0,6"><TextBlock Text="{Binding CpuValue}" FontSize="40" FontWeight="SemiBold"/><TextBlock Text="CPU" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,10"/></DockPanel><TextBlock Text="{Binding CpuName}"/><TextBlock Text="{Binding CpuFrequency}" Style="{StaticResource Muted}" Margin="0,5,0,0"/><local:Sparkline Values="{Binding CpuHistory}" Height="64" Margin="0,18,0,0"/><TextBlock Text="Temperatura: Não disponível" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Muted}"/><TextBlock Text="{Binding MemoryValue}" FontSize="40" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="{Binding MemoryDetail}"/><local:Sparkline Values="{Binding MemoryHistory}" Height="64" Margin="0,18,0,0"/><TextBlock Text="Histórico de até 60 leituras reais" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Muted}"/><TextBlock Text="{Binding GpuName}" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,18"/><TextBlock Text="Utilização · Não disponível&#10;VRAM em uso · Não disponível&#10;Temperatura · Não disponível" Style="{StaticResource Muted}"/><TextBlock Text="Sensores sem integração compatível são identificados explicitamente." Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SISTEMA OPERACIONAL" Style="{StaticResource Muted}"/><TextBlock Text="{Binding OsName}" FontSize="18" Margin="0,18,0,12"/><TextBlock Text="{Binding Uptime, StringFormat='Tempo ativo · {0}'}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ProcessCount, StringFormat='Processos · {0}'}" Style="{StaticResource Muted}" Margin="0,5"/><TextBlock Text="{Binding ActivePowerPlan, StringFormat='Energia · {0}'}" Style="{StaticResource Muted}"/></StackPanel></Border>
     </UniformGrid>
     <TextBlock Text="Armazenamento" FontSize="20" Margin="0,12,0,16"/>
     <ItemsControl ItemsSource="{Binding Drives}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel><ProgressBar Value="{Binding UsedPercent}"/><TextBlock Text="{Binding UsedPercent, StringFormat='{}{0:F0}% ocupado'}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{Binding MonitoringStatus}" Style="{StaticResource Muted}"/>
    </StackPanel></ScrollViewer></TabItem>
    <!-- SMART -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,28,16,20"><TextBlock Text="Otimização inteligente" Style="{StaticResource Title}"/><TextBlock Text="Analise, entenda e escolha. Nada é aplicado sem sua confirmação." Style="{StaticResource Muted}"/><WrapPanel Margin="0,18,0,20"><Button Content="Analisar novamente" Command="{Binding AnalyzeCommand}"/><Button Content="OTIMIZAR AGORA" Command="{Binding OptimizeCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
     <TextBlock Text="As recomendações aparecem após a análise. Sem oportunidades adicionais, o NEXUS não inventa ajustes." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
     <ItemsControl ItemsSource="{Binding Recommendations}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanApply}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Margin="0,10,0,10"/><TextBlock Text="{Binding Benefit}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SideEffects, StringFormat='Efeitos e limites: {0}'}" Style="{StaticResource Muted}" Margin="0,7,0,12"/><TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/><WrapPanel Margin="0,12,0,0"><Button Content="Aplicar com backup" Command="{Binding DataContext.ApplyRecommendationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanApply, Converter={StaticResource BoolVisibility}}"/><Button Content="Abrir configuração nativa ↗" Command="{Binding DataContext.OpenRecommendationToolCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasTool, Converter={StaticResource BoolVisibility}}"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
    <!-- GAMER -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,28,16,20"><TextBlock Text="Seu próximo jogo, preparado." Style="{StaticResource Title}"/><TextBlock Text="Perfis transparentes. Sem temporizadores, serviços desativados ou promessas de FPS." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ActivePowerPlan, StringFormat='Plano ativo · {0}'}" FontSize="18"/><TextBlock Text="Escolha apenas entre planos existentes. Alguns computadores com Modern Standby oferecem somente o Equilibrado." Style="{StaticResource Muted}" Margin="0,10,0,12"/><ComboBox ItemsSource="{Binding PowerPlans}" SelectedItem="{Binding SelectedPowerPlan}" DisplayMemberPath="Name" HorizontalAlignment="Left" MinWidth="300"/></StackPanel></Border>
     <UniformGrid Columns="3">
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="01 / EQUILIBRADO" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Consumo e estabilidade" FontSize="18" Margin="0,16,0,10"/><TextBlock Text="Ativa o plano Equilibrado, se disponível. Ajuste reversível e sem reinicialização." Style="{StaticResource Muted}" MinHeight="82"/><Button Content="Ativar Equilibrado" Command="{Binding ApplyProfileCommand}" CommandParameter="balanced"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="02 / GAMER" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Você escolhe o plano" FontSize="18" Margin="0,16,0,10"/><TextBlock Text="Ativa o plano selecionado acima. Revise aplicativos e Modo de Jogo separadamente." Style="{StaticResource Muted}" MinHeight="82"/><Button Content="Usar plano selecionado" Command="{Binding ApplyProfileCommand}" CommandParameter="gamer"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="03 / ALTO DESEMPENHO" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Desempenho disponível" FontSize="18" Margin="0,16,0,10"/><TextBlock Text="Ativa o plano Alto desempenho existente. Pode aumentar consumo, ruído e temperatura." Style="{StaticResource Muted}" MinHeight="82"/><Button Content="Ativar com confirmação" Command="{Binding ApplyProfileCommand}" CommandParameter="performance"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Seu jogo" FontSize="20"/><TextBlock Text="{Binding GamePath}" Style="{StaticResource Muted}" Margin="0,12,0,8"/><WrapPanel><Button Content="Selecionar executável" Command="{Binding SelectGameCommand}"/><Button Content="Preferências gráficas ↗" Command="{Binding OpenToolCommand}" CommandParameter="graphics"/><Button Content="Modo de Jogo ↗" Command="{Binding OpenToolCommand}" CommandParameter="game"/></WrapPanel><TextBlock Text="O executável é identificado e lembrado; não é iniciado nem modificado. Preferências por jogo são gerenciadas no Windows." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Controle do ponteiro" FontSize="20"/><TextBlock Text="Desativar a aceleração é opcional e afeta o desktop. Jogos com entrada bruta geralmente ignoram esse ajuste. Risco moderado; com backup e reversão." Style="{StaticResource Muted}" Margin="0,10,0,12"/><Button Content="Desativar aceleração com backup" Command="{Binding DisableMouseAccelerationCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
     <TextBlock Text="Para revisar aplicativos antes de jogar, consulte Monitoramento. Nenhum processo é encerrado automaticamente." Style="{StaticResource Muted}"/>
    </StackPanel></ScrollViewer></TabItem>
    <!-- CLEANUP -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,28,16,20"><TextBlock Text="Mais espaço. Com critério." Style="{StaticResource Title}"/><TextBlock Text="Somente áreas conhecidas, arquivos sem uso recente e categorias escolhidas por você." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <ItemsControl ItemsSource="{Binding CleanupCategories}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" FontSize="18"/><TextBlock Text="{Binding Warning}" Style="{StaticResource Muted}" Margin="0,6,0,8"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel><Button Content="Analisar espaço" Command="{Binding ScanCleanupCommand}"/><Button Content="Limpar arquivos analisados" Command="{Binding CleanCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBlock Text="{Binding CleanupSummary}" Margin="0,14,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Lixeira · autorização separada" FontSize="20"/><TextBlock Text="{Binding RecycleSummary}" Style="{StaticResource Muted}" Margin="0,12"/><WrapPanel><Button Content="Consultar tamanho" Command="{Binding QueryRecycleCommand}"/><Button Content="Esvaziar com confirmação" Command="{Binding EmptyRecycleCommand}"/></WrapPanel></StackPanel></Border>
     <TextBlock Text="Exclusões são permanentes e não podem ser desfeitas pelo histórico. Documentos, Downloads, saves, shaders, Prefetch e WinSxS não fazem parte das regras. Arquivos em uso ou sem permissão são ignorados." Style="{StaticResource Muted}"/>
    </StackPanel></ScrollViewer></TabItem>
    <!-- STARTUP -->
    <TabItem><Grid Margin="30,28,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Um início mais leve" Style="{StaticResource Title}"/><TextBlock Text="Entradas Run do usuário podem ser movidas para o arquivo de desativados do NEXUS, com backup. O estado mostrado é o da entrada, sem inferir políticas de terceiros." Style="{StaticResource Muted}"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,16"><Button Content="Atualizar lista" Command="{Binding RefreshStartupCommand}"/><Button Content="Ativar / desativar selecionado" Command="{Binding ToggleStartupCommand}"/><Button Content="Gerenciar no Windows ↗" Command="{Binding OpenToolCommand}" CommandParameter="startup"/></WrapPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding StartupEntries}" SelectedItem="{Binding SelectedStartup}" Background="{DynamicResource CanvasBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><CheckBox DockPanel.Dock="Right" Content="Entrada presente" IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Command}" Style="{StaticResource Muted}" Margin="0,8"/><TextBlock Text="{Binding Source}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/><TextBlock Text="{Binding Publisher, StringFormat='Fabricante · {0}'}" Style="{StaticResource Muted}" Margin="0,4"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="3" Text="Entradas de máquina, pastas Inicializar e tarefas agendadas: use o gerenciamento nativo. Para desfazer alterações do NEXUS, consulte o histórico." Style="{StaticResource Muted}" Margin="0,15,0,0"/>
    </Grid></TabItem>
    <!-- MONITOR -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,28,16,20"><TextBlock Text="O pulso do seu sistema" Style="{StaticResource Title}"/><TextBlock Text="Leituras reais. O monitoramento pausa fora do Dashboard e desta página, ou quando a janela perde o foco." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding CpuValue, StringFormat='CPU · {0}'}" FontSize="22"/><local:Sparkline Values="{Binding CpuHistory}" Height="130" Margin="0,20,0,10"/><TextBlock Text="0–100% · até 60 leituras" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding MemoryValue, StringFormat='RAM · {0}'}" FontSize="22"/><local:Sparkline Values="{Binding MemoryHistory}" Height="130" Margin="0,20,0,10"/><TextBlock Text="0–100% · até 60 leituras" Style="{StaticResource Muted}"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Limites dos sensores" FontSize="18"/><TextBlock Text="GPU (uso, VRAM e temperatura), temperatura da CPU e atividade de discos: Não disponível nesta versão. O espaço das unidades é medido no Dashboard." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     <TextBlock Text="Aplicativos e processos" FontSize="20" Margin="0,12,0,8"/><TextBlock Text="Até 12 processos acessíveis, ordenados por CPU e depois RAM. CPU é relativa à capacidade total do computador; precisa de duas leituras." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
     <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Background="Transparent" BorderThickness="0" MaxHeight="360" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,6"><DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="15,0,0,0"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     <WrapPanel><Button Content="Solicitar fechamento do selecionado" Command="{Binding RequestCloseCommand}"/><Button Content="Gerenciador de Tarefas ↗" Command="{Binding OpenToolCommand}" CommandParameter="tasks"/></WrapPanel><TextBlock Text="{Binding MonitoringStatus}" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <!-- TOOLS -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,28,16,20"><TextBlock Text="Ferramentas que você já conhece" Style="{StaticResource Title}"/><TextBlock Text="Acesso direto às ferramentas nativas. Ações administrativas pedem UAC no momento da execução." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <ItemsControl ItemsSource="{Binding Tools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,10,0,12" MinHeight="48"/><Button Content="Abrir ferramenta  ↗" Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
    <!-- HISTORY -->
    <TabItem><Grid Margin="30,28,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Cada mudança tem um caminho de volta" Style="{StaticResource Title}"/><TextBlock Text="Backup específico antes de cada ajuste persistente. Alterações interrompidas permanecem disponíveis para recuperação." Style="{StaticResource Muted}"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,16"><Button Content="Atualizar" Command="{Binding RefreshHistoryCommand}"/><Button Content="Desfazer selecionada" Command="{Binding RevertCommand}"/><Button Content="Restaurar todas" Command="{Binding RestoreAllCommand}"/><Button Content="Proteção do Sistema ↗" Command="{Binding OpenToolCommand}" CommandParameter="restore"/></WrapPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,10,0,5"/><TextBlock Text="{Binding Record.Id, StringFormat='ID · {0}'}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="3" Text="Restaure primeiro o ajuste mais recente de cada configuração. Mudanças externas não são sobrescritas silenciosamente. Pontos de restauração são gerenciados no Windows e não substituem estes backups. Exclusões de arquivos não são reversíveis." Style="{StaticResource Muted}" Margin="0,15,0,0"/>
    </Grid></TabItem>
    <!-- SETTINGS -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,28,16,20"><TextBlock Text="Do seu jeito" Style="{StaticResource Title}"/><TextBlock Text="Preferências locais. Aparência é aplicada imediatamente; use Salvar para manter entre sessões." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Aparência" FontSize="20" Margin="0,0,0,18"/><WrapPanel><StackPanel><TextBlock Text="Tema" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/></StackPanel><StackPanel><TextBlock Text="Cor de destaque" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}"/></StackPanel></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comportamento" FontSize="20" Margin="0,0,0,18"/><TextBlock Text="Intervalo de monitoramento (segundos)" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding MonitorInterval}" HorizontalAlignment="Left"/><CheckBox Content="Mostrar notificações de conclusão no aplicativo" IsChecked="{Binding Notifications}"/><CheckBox Content="Iniciar NEXUS com o Windows (confirmado ao salvar)" IsChecked="{Binding StartWithWindows}"/><TextBlock Text="Confirmações de alterações, exclusões e elevação permanecem obrigatórias." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados e diagnóstico" FontSize="20"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource Muted}" Margin="0,12"/><WrapPanel><Button Content="Abrir logs" Command="{Binding OpenLogsCommand}"/><Button Content="Exportar relatório JSON" Command="{Binding ExportReportCommand}"/></WrapPanel><TextBlock Text="Nenhuma informação é enviada. O relatório exportado contém o nome do computador e dos processos; revise antes de compartilhar." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     <WrapPanel><Button Content="Salvar preferências" Command="{Binding SavePreferencesCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Restaurar preferências" Command="{Binding ResetPreferencesCommand}"/></WrapPanel>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="30,12"><StackPanel><DockPanel><Button Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" DockPanel.Dock="Right" Padding="12,6"/><TextBlock Text="{Binding Status}" FontSize="12" MaxHeight="64" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#F18B8B"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Notifications}" Value="False"/><Condition Binding="{Binding HasError}" Value="False"/><Condition Binding="{Binding IsBusy}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel><ProgressBar IsIndeterminate="{Binding Indeterminate}" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Height="3" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</ui:FluentWindow>
